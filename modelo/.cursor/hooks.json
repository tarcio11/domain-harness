{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      { "command": "node harness/bin/hook.mjs shell", "timeout": 10 }
    ],
    "stop": [
      { "command": "node harness/bin/hook.mjs parar", "timeout": 30, "loop_limit": null }
    ],
    "preCompact": [
      { "command": "node harness/bin/hook.mjs compactar", "timeout": 5 }
    ]
  }
}
